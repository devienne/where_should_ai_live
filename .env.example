# Template for .env — copy it and fill in your own values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Mac/Linux)
# .env is git-ignored; this file is committed and must never hold real secrets.

# --- PostgreSQL / PostGIS (used by docker-compose.yml and the db/ scripts) ---
POSTGRES_USER=wsal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wsal
POSTGRES_HOST=localhost
# 5433 avoids clashing with a locally installed PostgreSQL on 5432
POSTGRES_PORT=5433
